# Copy to .env for local development (`make run`, `make dev`, integration tests).
# .env is git-ignored. Never commit real credentials.
#
# Every secret can also be read from a file: set NAME_FILE=/path instead of NAME.

# development | production (default: production).
# production requires TLS: sslmode=verify-full and an https S3 endpoint.
APP_ENV=development

# Short name of this site: lowercase letters, digits and hyphens.
SITE_ID=dev

# Listen address (default: 127.0.0.1:8080, loopback only). To reach the
# platform from other devices over a VPN (NetBird/WireGuard), listen on the VPN
# interface's address only, not on 0.0.0.0, e.g. 100.80.128.240:8443.
HTTP_ADDR=127.0.0.1:8080

# The address users open in their browser (scheme, host, port; no path).
# Used for activation links. Must be https in production; session cookies are
# then Secure and __Host- prefixed.
PUBLIC_URL=http://localhost:8080

# 32 random bytes, base64. Encrypts secrets at rest (such as TOTP secrets).
# Generate with: openssl rand -base64 32
# Keep a copy in your password manager: without it, every user has to
# re-enrol their authenticator app. All sites must share the same key.
ENCRYPTION_KEY=

# debug | info | warn | error (default: info).
LOG_LEVEL=debug

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full

# A separate, disposable database for `make test-integration`; never your real one.
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME_test?sslmode=verify-full

S3_ENDPOINT=https://s3.example.internal
S3_REGION=us-east-1
S3_BUCKET=platform
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true = path-style URLs (https://host/bucket), needed by most self-hosted S3 servers
# that have no wildcard DNS. false = let the client decide.
S3_FORCE_PATH_STYLE=false

# Outgoing mail (optional; without SMTP_HOST mail is off and activation links
# are only shown on screen). SMTP_SECURITY: tls (port 465, default),
# starttls (port 587) or none (development only).
SMTP_HOST=
SMTP_SECURITY=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Quote values with spaces or <>: the shell (make) and Docker Compose strip the
# quotes. Plain `docker run --env-file` does not; use Compose instead.
SMTP_FROM="Cloud <cloud@example.com>"

# Collabora Online for editing documents in the browser (optional). Only
# scheme, host and port; Collabora's server_name must give this same origin,
# and its aliasgroup1 must be PUBLIC_URL.
COLLABORA_URL=
