# Compose settings. Copy to .env (never commit it).
# The NetBird address of ave-dev-cloud: Traefik only listens there.
BIND_IP=100.80.135.255
# Pin exact versions (see README: Versies). Compose refuses to start without.
TRAEFIK_VERSION=
COLLABORA_VERSION=
# Let's Encrypt account e-mail and your DNS provider's name in Traefik
# (https://doc.traefik.io/traefik/https/acme/#providers), e.g. cloudflare, transip.
ACME_EMAIL=
ACME_DNS_PROVIDER=
