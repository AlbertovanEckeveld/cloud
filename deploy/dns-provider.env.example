# API credentials for your DNS provider, used only by Traefik for the DNS-01
# challenge. Copy to dns-provider.env (never commit it). Use a token that may
# only edit DNS records of albertove.cloud. Examples:
#   Cloudflare: CF_DNS_API_TOKEN=...
#   TransIP:    TRANSIP_ACCOUNT_NAME=...  TRANSIP_PRIVATE_KEY_PATH=/secrets/transip.key
