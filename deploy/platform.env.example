# Platform settings for staging. Copy to platform.env (never commit it).
# Development mode, because staging runs on plain http over NetBird for now
# (WireGuard encrypts it); production mode refuses http.
APP_ENV=development
SITE_ID=staging
PUBLIC_URL=http://ave-dev-cloud.albertove.cloud:8080
HTTP_ADDR=:8080
# The key the database is sealed with (README, step 1). The platform refuses
# to start with any other key.
ENCRYPTION_KEY=

# The existing database with your data, reached over the private Docker
# network (README, step 1). Never share a database between environments.
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/ave_cloud?sslmode=disable
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# The existing Collabora on this machine; its aliasgroup must allow
# http://ave-dev-cloud.albertove.cloud:8080 (see README).
COLLABORA_URL=

# Optional outgoing mail (activation links, security notices).
SMTP_HOST=
