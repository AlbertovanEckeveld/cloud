# Platform settings for staging. Copy to platform.env (never commit it).
APP_ENV=production
SITE_ID=staging
PUBLIC_URL=https://ave-dev-cloud.albertove.cloud
HTTP_ADDR=:8080
# 32 random bytes, base64: openssl rand -base64 32. A NEW key, not the dev key.
ENCRYPTION_KEY=

# A new, empty database on the existing Postgres (see README). Plain text is
# allowed only because postgres is on the private Docker network: listed in
# PRIVATE_NETWORK_HOSTS.
DATABASE_URL=postgres://cloud_staging:CHANGE-ME@postgres:5432/ave_cloud_staging?sslmode=disable
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=ave-cloud-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
PRIVATE_NETWORK_HOSTS=postgres,rustfs

# Traefik's fixed address on the edge network (compose.yaml).
TRUSTED_PROXIES=172.31.250.10

COLLABORA_URL=https://ave-dev-cloud.albertove.cloud

# Optional outgoing mail (activation links, security notices).
SMTP_HOST=
