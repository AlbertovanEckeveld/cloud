# Platform settings for staging. Copy to platform.env (never commit it).
# Development mode, because staging runs on plain http over NetBird for now
# (WireGuard encrypts it); production mode refuses http.
APP_ENV=development
SITE_ID=staging
PUBLIC_URL=http://ave-dev-cloud.albertove.cloud:8080
HTTP_ADDR=:8080
# 32 random bytes, base64: openssl rand -base64 32. A NEW key, not the dev key.
ENCRYPTION_KEY=

# A new, empty database on the existing Postgres (see README), reached over
# the private Docker network.
DATABASE_URL=postgres://cloud_staging:CHANGE-ME@postgres:5432/ave_cloud_staging?sslmode=disable
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=ave-cloud-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# The existing Collabora on this machine; its aliasgroup must allow
# http://ave-dev-cloud.albertove.cloud:8080 (see README).
COLLABORA_URL=

# Optional outgoing mail (activation links, security notices).
SMTP_HOST=
